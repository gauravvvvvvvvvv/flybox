{
  "name": "flybox-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run audit:browser && npm run check && npm run prepare:browser && vite build",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "fetch:connectome": "node ../scripts/fetch-browser-connectome.mjs",
    "fetch:soma": "python ../scripts/export-browser-soma.py",
    "prepare:browser": "npm run fetch:connectome && npm run fetch:soma",
    "build:browser": "npm run build",
    "predev": "npm run fetch:soma",
    "audit:browser": "node ../scripts/audit-browser-ui.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "typescript": "^7.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3"
  }
}
